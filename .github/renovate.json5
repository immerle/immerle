{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
    'security:openssf-scorecard',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  timezone: 'Europe/Paris',
  schedule: [
    'before 7am on monday',
  ],
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  commitMessageLowerCase: 'never',
  labels: [
    'dependencies',
  ],
  rebaseWhen: 'behind-base-branch',
  prConcurrentLimit: 8,
  prHourlyLimit: 3,
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
    'npmDedupe',
  ],
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
    schedule: [
      'at any time',
    ],
    minimumReleaseAge: null,
    prCreation: 'immediate',
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 7am',
    ],
  },
  automerge: false,
  ignoreDeps: [
    'ghcr.io/immerle/immerle',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'major',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchUpdateTypes: [
        'patch',
        'pin',
        'digest',
      ],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-non-major',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^v?0\\./',
      groupName: 'all non-major dependencies',
      groupSlug: 'all-non-major',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '/^v?0\\./',
      labels: [
        'dependencies',
        'breaking',
      ],
    },
    {
      groupName: 'docusaurus',
      matchUpdateTypes: [
        'major',
      ],
      matchPackageNames: [
        '@docusaurus/**',
        'redocusaurus',
      ],
    },
    {
      matchFileNames: [
        'ui/package.json',
      ],
      matchPackageNames: [
        'expo-**',
        '@expo/**',
        'react',
        'react-dom',
        '@types/react',
        'react-native',
        'react-native-**',
        '!react-native-draggable-flatlist',
        '@react-native/**',
        '@react-native-community/**',
        '@react-native-async-storage/**',
        '@shopify/flash-list',
        'jest-expo',
        'babel-preset-expo',
        'eslint-config-expo',
      ],
      enabled: false,
    },
    {
      matchFileNames: [
        'ui/package.json',
      ],
      matchPackageNames: [
        'expo',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
      ],
      enabled: false,
    },
    {
      groupName: 'expo sdk',
      matchFileNames: [
        'ui/package.json',
      ],
      matchPackageNames: [
        'expo',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
